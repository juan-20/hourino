# @import(../../apps/server/, pick=[NODE_ENV, CORS_ORIGIN, BETTER_AUTH_SECRET, BETTER_AUTH_URL, POLAR_ACCESS_TOKEN, POLAR_SUCCESS_URL, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, RESEND_API_KEY, RESEND_FROM_EMAIL])
# @currentEnv=$ALCHEMY_STAGE
# @defaultRequired=false
# @defaultSensitive=true
# ---

# Alchemy stage: "dev" (`bun run dev`: local processes + the dev Neon DB) or
# "prd" (`bun run deploy`). Set by this package's scripts, and read by both the
# Alchemy CLI (stage name) and Varlock (@currentEnv above), so `.env.dev` /
# `.env.prd` override the shared `.env`: that's where each stage's own
# BETTER_AUTH_URL / CORS_ORIGIN / POLAR_SUCCESS_URL go.
# @sensitive=false
ALCHEMY_STAGE=
ALCHEMY_PASSWORD=
