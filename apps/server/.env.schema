# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public origin of this server. NOT sensitive: it is echoed verbatim in
# Better Auth's own OpenAPI reference (`/api/auth/reference`) and in the
# generated `/docs` document, and varlock's response leak-scanner turns any
# sensitive value found in a response body into a 500.
# @sensitive=false @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
POLAR_ACCESS_TOKEN=

# @type=url
POLAR_SUCCESS_URL=

# Public origin of the web client — echoed in CORS headers and in the
# password-reset callback URL, so it must not be treated as sensitive.
# @sensitive=false @type=url
CORS_ORIGIN=

# Google's OAuth Client ID is a public identifier by design — Better Auth
# embeds it in the redirect URL sent to Google's authorization endpoint, and
# varlock's response leak-scanner turns any sensitive value found in a
# response body into a 500 (same reasoning as BETTER_AUTH_URL/CORS_ORIGIN
# above). Only GOOGLE_CLIENT_SECRET is an actual secret.
# @sensitive=false @type=string(minLength=1)
GOOGLE_CLIENT_ID=

# @type=string(minLength=1)
GOOGLE_CLIENT_SECRET=

# @type=string(minLength=1)
RESEND_API_KEY=

# @type=email
RESEND_FROM_EMAIL=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_API_KEY=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=string(minLength=1)
AXIOM_DATASET=

# Supplied by Alchemy at runtime; builds do not need ingest credentials.
# @dynamic @required=false @type=url
AXIOM_EDGE_URL=

# Supplied by Alchemy at runtime (Neon.Project's pooled connection URI).
# Varlock's own resolution of this var is unreliable specifically for this
# key under `alchemy dev`'s local process spawn (confirmed: process.env.DATABASE_URL
# is present and correct at runtime, but ENV.DATABASE_URL resolves as undefined —
# marking @required=false here only stops the fatal boot-time validation crash;
# services.ts reads process.env.DATABASE_URL directly instead of ENV.DATABASE_URL.
# @dynamic @required=false @type=string(minLength=1)
DATABASE_URL=
